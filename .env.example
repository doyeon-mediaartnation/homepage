# Copy this file to .env and fill in the real values. .env is gitignored.
# These are read by the contact form function (api/contact.js) on Vercel.
# For deployment, enter the same variables in Vercel → Settings → Environment Variables.

# Azure Communication Services → Keys → Connection string (Primary)
ACS_CONNECTION_STRING=endpoint=https://<name>.korea.communication.azure.com/;accesskey=<key>

# Email Communication Service → Provision domains → MailFrom address
ACS_SENDER=DoNotReply@<guid>.azurecomm.net

# Where inquiries are delivered — one or more mailboxes, comma-separated (up to 10)
CONTACT_TO=contact@mediaartnation.studio
